    },
    {
      "key": "id_context_precision_pack",
      "label": "Context precision (IDs, evidence pack)",
      "family": "ragas_non_llm",
      "ragas_class": "IDBasedContextPrecision",
      "needs_llm": false,
      "needs_reference_answer": false,
      "inputs": [
        "retrieved_context_ids (evidence pack handles)",
        "reference_context_ids (gold handles)"
      ],
      "what_it_measures": "Share of distinct evidence-pack handles that are gold handles. Undefined for an empty pack."
    },
    {
      "key": "id_context_recall_cited",
      "label": "Context recall (IDs, cited passages)",
      "family": "ragas_non_llm",
      "ragas_class": "IDBasedContextRecall",
      "needs_llm": false,
      "needs_reference_answer": false,
      "inputs": [
        "cited_context_ids (handles cited in the answer)",
        "reference_context_ids (gold handles)"
      ],
      "what_it_measures": "Share of distinct gold passage handles that the answer actually cites."
    },
    {
      "key": "id_context_precision_cited",
      "label": "Context precision (IDs, cited passages)",
      "family": "ragas_non_llm",
      "ragas_class": "IDBasedContextPrecision",
      "needs_llm": false,
      "needs_reference_answer": false,
      "inputs": [
        "cited_context_ids (handles cited in the answer)",
        "reference_context_ids (gold handles)"
      ],
      "what_it_measures": "Share of distinct cited handles that are gold handles. Undefined when the answer cites nothing."
    },
    {
      "key": "nonllm_context_recall_pack",
      "label": "Context recall (text similarity, evidence pack)",
      "family": "ragas_non_llm",
      "ragas_class": "NonLLMContextRecall",
      "needs_llm": false,
      "needs_reference_answer": false,
      "inputs": [
        "retrieved_contexts (evidence pack passage texts)",
        "reference_contexts (gold passage texts)"
      ],
      "what_it_measures": "Share of gold passages whose best normalised string similarity to any pack passage exceeds 0.5. A lexical heuristic, not a judgement of meaning."
    },
    {
      "key": "nonllm_context_precision_pack",
      "label": "Context precision (text similarity, evidence pack)",
      "family": "ragas_non_llm",
      "ragas_class": "NonLLMContextPrecisionWithReference",
      "needs_llm": false,
      "needs_reference_answer": false,
      "inputs": [
        "retrieved_contexts (evidence pack passage texts)",
        "reference_contexts (gold passage texts)"
      ],
      "what_it_measures": "Rank-weighted average precision of pack passages, where a pack passage counts as relevant when its best string similarity to a gold passage is at least 0.5."
    },
    {
      "key": "faithfulness",
      "label": "Faithfulness (model-judged)",
      "family": "ragas_llm_judge",
      "ragas_class": "Faithfulness",
      "needs_llm": true,
      "needs_reference_answer": false,
      "inputs": [
        "user_input",
        "response",
        "retrieved_contexts (evidence pack passage texts)"
      ],
      "what_it_measures": "Share of the answer's claims that a judge model finds supported by the evidence pack."
    },
    {
      "key": "answer_relevancy",
      "label": "Answer relevancy (model-judged)",
      "family": "ragas_llm_judge",
      "ragas_class": "AnswerRelevancy",
      "needs_llm": true,
      "needs_reference_answer": false,
      "inputs": [
        "user_input",
        "response"
      ],
      "what_it_measures": "Mean embedding similarity between the question and questions a judge model generates from the answer; zero when the answer is non-committal."
    },
    {
      "key": "llm_context_precision_with_reference",
      "label": "Context precision vs reference (model-judged)",
      "family": "ragas_llm_judge",
      "ragas_class": "ContextPrecisionWithReference",
      "needs_llm": true,
      "needs_reference_answer": true,
      "inputs": [
        "user_input",
        "reference",
        "retrieved_contexts (evidence pack passage texts)"
      ],
      "what_it_measures": "Rank-weighted precision of pack passages judged useful for an authored reference answer."
    },
    {
      "key": "llm_context_recall",
      "label": "Context recall vs reference (model-judged)",
      "family": "ragas_llm_judge",
      "ragas_class": "ContextRecall",
      "needs_llm": true,
      "needs_reference_answer": true,
      "inputs": [
        "user_input",
        "reference",
        "retrieved_contexts (evidence pack passage texts)"
      ],
      "what_it_measures": "Share of an authored reference answer's statements that a judge model attributes to the evidence pack."
    },
    {
      "key": "factual_correctness",
      "label": "Factual correctness vs reference (model-judged)",
      "family": "ragas_llm_judge",
      "ragas_class": "FactualCorrectness",
      "needs_llm": true,
      "needs_reference_answer": true,
      "inputs": [
        "response",
        "reference"
      ],
      "what_it_measures": "Claim-level F1 between the answer and an authored reference answer, as judged by a model."
    }
  ],
