# Copy to .env for local development:  cp .env.example .env
# All values here are DEV-ONLY placeholders. Never put real secrets in this file.

# ── docker compose: bootstrap superuser (used only by the init script) ───────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev-only-insecure-bootstrap
POSTGRES_DB=marketsignal
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000

# ── role passwords created by backend/db/init/01_roles.sh ────────────────────
MS_OWNER_PASSWORD=dev-only-insecure-owner
MS_APP_PASSWORD=dev-only-insecure-app

# ── backend (native "light mode": services on localhost) ─────────────────────
MS_ENV=dev
# Runtime role: non-owner, non-superuser, non-BYPASSRLS (row-level security applies).
MS_DATABASE_URL=postgresql+psycopg://ms_app:dev-only-insecure-app@localhost:5432/marketsignal
# Schema-owner role: Alembic migrations only.
MS_MIGRATIONS_DATABASE_URL=postgresql+psycopg://ms_owner:dev-only-insecure-owner@localhost:5432/marketsignal
MS_REDIS_URL=redis://localhost:6379/0
MS_LOG_JSON=false
MS_CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# ── frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── model providers (needed from Phase 3; leave empty until then) ────────────
# ANTHROPIC_API_KEY=
