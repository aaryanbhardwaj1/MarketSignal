#!/usr/bin/env bash
# Local pre-commit guard. Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
"$root/scripts/check_repo_safety.sh" --staged
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner --config "$root/.gitleaks.toml"
else
  echo "pre-commit: gitleaks not installed locally; secret scanning runs in CI" >&2
fi
# Lint + format check staged Python files with the backend's ruff configuration.
files=()
while IFS= read -r f; do files+=("$root/$f"); done \
  < <(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
if [ "${#files[@]}" -gt 0 ] && command -v uv >/dev/null 2>&1; then
  uv --directory "$root/backend" run --quiet ruff check "${files[@]}"
  uv --directory "$root/backend" run --quiet ruff format --check "${files[@]}"
fi
